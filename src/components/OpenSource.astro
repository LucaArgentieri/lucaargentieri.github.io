---
import { getPinnedRepos } from '../lib/github';

const repos = await getPinnedRepos();
---

<section class="pt-10" aria-labelledby="open-source-heading">
	<h2 id="open-source-heading" class="mb-4 text-fine font-medium text-fg-muted uppercase">
		Open source · Pinned on GitHub
	</h2>
	<ul class="grid gap-3">
		{
			repos.map((repo) => (
				<li class="group relative flex flex-col rounded-xl border border-border bg-bg-subtle p-4 transition-colors duration-200 ease-out hover:border-fg-muted focus-within:border-fg-muted">
					<h3 class="text-h3 font-semibold tracking-tight text-fg-strong">
						<a
							href={repo.href}
							target="_blank"
							rel="noopener noreferrer"
							class="after:absolute after:inset-0 after:rounded-xl underline decoration-accent/50 underline-offset-4 transition-[text-decoration-color] duration-200 ease-out hover:decoration-accent"
						>
							{repo.name}
							<span class="sr-only"> (opens on GitHub in a new tab)</span>
						</a>
					</h3>
					{repo.description && <p class="mt-2 flex-1 text-meta text-fg">{repo.description}</p>}
					{repo.topics.length > 0 && (
						<ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Topics">
							{repo.topics.map((topic) => (
								<li class="rounded-full border border-border px-2 py-0.5 font-mono text-fine text-fg-muted">{topic}</li>
							))}
						</ul>
					)}
					<dl class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-meta text-fg-muted">
						{repo.language && (
							<div class="flex items-center gap-1.5">
								<dt class="sr-only">Language</dt>
								<dd class="flex items-center gap-1.5">
									<span
										aria-hidden="true"
										class="inline-block h-2.5 w-2.5 rounded-full"
										style={`background-color:${repo.language.color ?? 'currentColor'}`}
									/>
									{repo.language.name}
								</dd>
							</div>
						)}
						{repo.stars > 0 && (
							<div class="flex items-center gap-1">
								<dt class="sr-only">Stars</dt>
								<dd class="flex items-center gap-1">
									<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
										<path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
									</svg>
									{repo.stars}
								</dd>
							</div>
						)}
						{repo.forks > 0 && (
							<div class="flex items-center gap-1">
								<dt class="sr-only">Forks</dt>
								<dd class="flex items-center gap-1">
									<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
										<path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
									</svg>
									{repo.forks}
								</dd>
							</div>
						)}
					</dl>
				</li>
			))
		}
	</ul>
</section>
