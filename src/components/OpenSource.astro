---
import { openSource } from '../data/site';
---

<section class="pt-10">
	<h2 class="mb-4 text-fine font-medium text-fg-muted uppercase">Open source</h2>
	<div class="flex flex-col">
		{
			openSource.map((repo) => (
				<article class="border-b border-border-soft py-5 first:pt-0 last:border-b-0">
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h3 class="text-h3 font-semibold tracking-tight text-fg-strong">{repo.name}</h3>
						{repo.stat && (
							<span class="flex-shrink-0 rounded-full border border-border bg-bg-subtle px-2.5 py-0.5 font-mono text-fine tracking-[0.08em] text-fg-muted uppercase">
								{repo.stat}
							</span>
						)}
					</div>
					<p class="mt-2 text-fg">{repo.description}</p>
					<a
						class="mt-3 inline-block text-meta underline underline-offset-4 decoration-orange hover:opacity-60"
						href={repo.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						View on GitHub
					</a>
				</article>
			))
		}
	</div>
</section>
