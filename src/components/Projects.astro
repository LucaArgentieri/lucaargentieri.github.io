---
import { projects } from '../data/site';
---

<section class="pt-10" aria-labelledby="projects-heading">
	<h2 id="projects-heading" class="mb-4 text-fine font-medium text-fg-muted uppercase">Projects</h2>
	<div class="flex flex-col">
		{
			projects.map((project) => (
				<article class="border-b border-border-soft py-5 first:pt-0 last:border-b-0">
					<h3 class="text-h3 font-semibold tracking-tight text-fg-strong">{project.title}</h3>
					<p class="text-meta text-fg-muted">{project.subtitle}</p>
					<p class="mt-2 font-mono text-meta text-fg-muted">{project.meta}</p>
					<p class="mt-1 font-mono text-meta text-fg-muted">Technologies — {project.technologies}</p>
					{project.description && <p class="mt-3 text-fg">{project.description}</p>}
					<a
						class="mt-3.5 inline-block text-meta underline underline-offset-4 decoration-accent/50 transition-[text-decoration-color] duration-200 ease-out hover:decoration-accent"
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						Visit website<span class="sr-only"> {project.title} (opens in a new tab)</span>
					</a>
				</article>
			))
		}
	</div>
</section>
