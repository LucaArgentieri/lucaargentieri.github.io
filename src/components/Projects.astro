---
import { projects } from '../data/site';
---

<section class="pt-10">
	<h2 class="mb-4 text-fine font-medium text-fg-muted uppercase">Projects</h2>
	<div class="flex flex-col">
		{
			projects.map((project) => (
				<article class="border-b border-border-soft py-5 first:pt-0 last:border-b-0">
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h3 class="text-h3 font-semibold tracking-tight text-fg-strong">{project.title}</h3>
						<span class="text-meta text-fg-muted">{project.subtitle}</span>
					</div>
					<p class="mt-2 font-mono text-meta text-fg-muted">{project.meta}</p>
					<p class="mt-1 font-mono text-meta text-fg-muted">Technologies — {project.technologies}</p>
					{project.description && <p class="mt-3 text-fg">{project.description}</p>}
					<a
						class="mt-3.5 inline-block text-meta underline underline-offset-4 decoration-orange hover:opacity-60"
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
					>
						Visit website
					</a>
				</article>
			))
		}
	</div>
</section>
