---
import '../styles/global.css';
import StructuredData from '../components/StructuredData.astro';
import { person } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Luca Argentieri',
	description = `${person.role}. I build fast, well-crafted web experiences with Nuxt, Sanity and Shopify.`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
const ogImageAlt = `${person.name} — ${person.role}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Luca Argentieri" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1b1a18" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="light dark" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Luca Argentieri" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="628" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<script is:inline>
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('theme');
				} catch {}
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.dataset.theme = theme;
				// Mirrors --color-bg. Keeps the browser chrome in sync with the manual
				// toggle, not just the OS setting.
				window.__setThemeColor = (t) => {
					document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
						m.removeAttribute('media');
						m.setAttribute('content', t === 'dark' ? '#1b1a18' : '#fdfdfc');
					});
				};
				window.__setThemeColor(theme);
			})();
		</script>

		<StructuredData />
	</head>
	<body class="relative">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-fg-strong focus:px-3 focus:py-2 focus:text-bg"
		>
			Skip to content
		</a>
		<div
			aria-hidden="true"
			class="pointer-events-none fixed inset-x-0 top-0 z-50 h-12 edge-fade-top"
		>
		</div>
		<slot />
		<div
			aria-hidden="true"
			class="pointer-events-none fixed inset-x-0 bottom-0 z-50 h-12 edge-fade-bottom"
		>
		</div>
	</body>
</html>
