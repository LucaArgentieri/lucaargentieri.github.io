---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Luca Argentieri',
	description = 'Senior Frontend Developer. I build fast, well-crafted web experiences with Nuxt, Sanity and Shopify.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Luca Argentieri" />
		<meta name="robots" content="index, follow" />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/og-image.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body>
		<div
			class="pointer-events-none fixed inset-x-0 top-0 z-50 h-20 bg-gradient-to-b from-black/10 to-transparent backdrop-blur-3xl [mask-image:linear-gradient(to_bottom,black,transparent)] dark:from-black/50"
		>
		</div>
		<slot />
		<div
			class="pointer-events-none fixed inset-x-0 bottom-0 z-50 h-20 bg-gradient-to-t from-black/10 to-transparent backdrop-blur-3xl [mask-image:linear-gradient(to_top,black,transparent)] dark:from-black/50"
		>
		</div>
	</body>
</html>
